# ============================================================
#  Variables del backend — Paz y Salvo
#  Copia este archivo como ".env" y rellena los valores.
#  NUNCA subas el archivo .env a GitHub.
# ============================================================

# Supabase > Project Settings > Data API  →  "Project URL"
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase > Project Settings > API Keys  →  "service_role" (pestaña Legacy)
#   o la "Secret key" (empieza con sb_secret_...)
# ⚠ Es la clave con acceso total: solo backend / Vercel, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-clave-secreta

# Nombre del bucket creado con schema.sql
SUPABASE_BUCKET=uploads

# Puerto local del API (Vercel lo ignora)
PORT=4000
